          }
        },
        {
          "name": "§3.10 — Preguntar por viáticos (2/2, comparar \"sources\")",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"message\": \"¿Hasta cuándo tengo para presentar mis facturas de viaje?\",\n  \"history\": []\n}" },
            "url": { "raw": "http://localhost:8000/chat", "protocol": "http", "host": ["localhost"], "port": "8000", "path": ["chat"] },
            "description": "Misma pregunta que el request anterior a este bloque — compara el campo \"sources\" ahora que el contenido está en 4 fragmentos en vez de 1 documento largo."
          }
        }
      ]
