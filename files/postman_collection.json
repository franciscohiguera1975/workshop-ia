            "url": { "raw": "http://localhost:8000/chat", "protocol": "http", "host": ["localhost"], "port": "8000", "path": ["chat"] }
          }
        }
      ]
    },
    {
      "name": "03 — RAG",
      "item": [
        {
          "name": "§3.8 — Agregar documento (vacaciones)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Política de vacaciones\",\n  \"text\": \"Los empleados tienen derecho a 15 días hábiles de vacaciones al año, acumulables hasta por 2 años.\"\n}" },
            "url": { "raw": "http://localhost:8000/documents", "protocol": "http", "host": ["localhost"], "port": "8000", "path": ["documents"] }
          }
        },
        {
          "name": "§3.8 — Preguntar usando sinónimos (/chat)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"message\": \"¿Cuántos días de descanso remunerado tengo por año?\",\n  \"history\": []\n}" },
            "url": { "raw": "http://localhost:8000/chat", "protocol": "http", "host": ["localhost"], "port": "8000", "path": ["chat"] }
          }
        },
        {
          "name": "§3.8 — Consultar la base vectorial directo (/search)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/search?q=¿Cuántos días de descanso remunerado tengo por año?",
              "protocol": "http", "host": ["localhost"], "port": "8000", "path": ["search"],
              "query": [{ "key": "q", "value": "¿Cuántos días de descanso remunerado tengo por año?" }]
            },
            "description": "Pasa por LanceDB, no por el LLM — sirve para aislar si un problema viene de los embeddings/retrieval o del modelo."
          }
        },
        {
          "name": "(bonus) Listar documentos cargados",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "http://localhost:8000/documents", "protocol": "http", "host": ["localhost"], "port": "8000", "path": ["documents"] }
          }
        },
        {
          "name": "§3.10 — Cargar documento largo (sin trocear)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Manual del empleado (completo)\",\n  \"text\": \"Horario: la jornada es de 8:00 a 17:00 con una hora de almuerzo. Vacaciones: los empleados tienen derecho a 15 días hábiles de vacaciones al año, acumulables hasta por 2 años. Teletrabajo: se permite hasta 3 días a la semana con aprobación del jefe directo. Viáticos: se reembolsan contra factura, hasta 30 días después del viaje.\"\n}" },
            "url": { "raw": "http://localhost:8000/documents", "protocol": "http", "host": ["localhost"], "port": "8000", "path": ["documents"] }
          }
        },
        {
          "name": "§3.10 — Preguntar por viáticos (1/2, documento sin trocear)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"message\": \"¿Hasta cuándo tengo para presentar mis facturas de viaje?\",\n  \"history\": []\n}" },
            "url": { "raw": "http://localhost:8000/chat", "protocol": "http", "host": ["localhost"], "port": "8000", "path": ["chat"] }
          }
        },
        {
          "name": "§3.10 — Mismo contenido en 4 fragmentos (1/4 — Horario)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"title\": \"Manual — Horario\", \"text\": \"La jornada es de 8:00 a 17:00 con una hora de almuerzo.\"}" },
            "url": { "raw": "http://localhost:8000/documents", "protocol": "http", "host": ["localhost"], "port": "8000", "path": ["documents"] }
          }
        },
        {
          "name": "§3.10 — Mismo contenido en 4 fragmentos (2/4 — Vacaciones)",
          "request": {
