            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"title\": \"Manual — Vacaciones\", \"text\": \"Los empleados tienen derecho a 15 días hábiles de vacaciones al año, acumulables hasta por 2 años.\"}" },
            "url": { "raw": "http://localhost:8000/documents", "protocol": "http", "host": ["localhost"], "port": "8000", "path": ["documents"] }
          }
