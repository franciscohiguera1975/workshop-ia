{
  "info": {
    "name": "Workshop IA — Más allá del chat",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 — Chat simple",
      "item": [
        {
          "name": "§1.3 — Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "http://localhost:8000/health", "protocol": "http", "host": ["localhost"], "port": "8000", "path": ["health"] }
          }
        },
        {
          "name": "§1.7 — Chat simple",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"message\": \"Explícame qué es una API en una frase\",\n  \"history\": []\n}" },
            "url": { "raw": "http://localhost:8000/chat", "protocol": "http", "host": ["localhost"], "port": "8000", "path": ["chat"] }
          }
        },
        {
          "name": "§1.10 — Memoria (1/2): le decimos el nombre",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"message\": \"Me llamo Ana. Recuérdalo.\",\n  \"history\": []\n}" },
            "url": { "raw": "http://localhost:8000/chat", "protocol": "http", "host": ["localhost"], "port": "8000", "path": ["chat"] },
            "description": "El backend es stateless: copia el \"reply\" de esta respuesta y pégalo en el history del siguiente request."
          }
        },
        {
          "name": "§1.10 — Memoria (2/2): pregunta por el nombre",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"message\": \"¿Cómo me llamo?\",\n  \"history\": [\n    {\"role\": \"user\", \"content\": \"Me llamo Ana. Recuérdalo.\"},\n    {\"role\": \"assistant\", \"content\": \"PEGA_AQUI_LA_RESPUESTA_ANTERIOR\"}\n  ]\n}" },
            "url": { "raw": "http://localhost:8000/chat", "protocol": "http", "host": ["localhost"], "port": "8000", "path": ["chat"] },
            "description": "Reemplaza PEGA_AQUI_LA_RESPUESTA_ANTERIOR por el \"reply\" real del request anterior antes de enviar."
          }
        }
      ]
    },
    {
